{
  "name": "conclave-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @conclave/server db:migrate",
    "agent:new": "tsx packages/cli/src/index.ts agent:new",
    "doctor": "tsx packages/cli/src/index.ts doctor"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
