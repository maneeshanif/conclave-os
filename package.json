{
  "name": "conclave-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @conclave/server db:migrate",
    "agent:new": "tsx --env-file-if-exists=.env packages/cli/src/index.ts agent:new",
    "doctor": "tsx --env-file-if-exists=.env packages/cli/src/index.ts doctor",
    "agent:render": "tsx --env-file-if-exists=.env packages/cli/src/index.ts agent:render",
    "eval:gate": "tsx --env-file-if-exists=.env packages/cli/src/index.ts eval:gate",
    "eval:baseline": "tsx --env-file-if-exists=.env packages/cli/src/index.ts eval:baseline",
    "backup": "tsx --env-file-if-exists=.env packages/cli/src/index.ts backup",
    "backup:restore": "tsx --env-file-if-exists=.env packages/cli/src/index.ts backup:restore",
    "e2e": "tsx --env-file-if-exists=.env packages/cli/src/index.ts e2e",
    "e2e:mobile": "pnpm --filter @conclave/web build && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
