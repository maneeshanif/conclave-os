# Names only. Never commit real values. Copy to .env and fill in what the current slice needs.

# Slice 0
PORT=3100
PG_PORT=54329                # embedded Postgres, 127.0.0.1 only
DATA_DIR=~/.conclave-os      # must be outside this repo

# Team mode only (local mode uses the embedded database)
DATABASE_URL=

# Inngest (the dev server needs neither locally)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Slice 1: outreach, login
SECRETS_KEY=                 # 32 random bytes, base64. Encrypts the secrets table.
RESEND_API_KEY=
OUTREACH_FROM=hello@conclaveai.pro

# Slice 2: lead gen
APOLLO_API_KEY=
APIFY_TOKEN=

# Slice 4: local model, through an OpenAI-compatible endpoint
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Slice 7: engineering
GITHUB_TOKEN=
VERCEL_TOKEN=

# Slice 9: API keys. Do not set these earlier: with one set, a CLI may bill the API instead of your plan.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Login (S1-10). Off by default: the server answers on this laptop only.
# LOGIN=on turns on the owner login (passkeys). A first-time setup code is written to DATA_DIR/owner-setup-code.txt.
# Use http://localhost:3000 and http://localhost:3100 (not 127.0.0.1): a passkey needs a domain name, and localhost counts.
LOGIN=
# Listening beyond this laptop needs LOGIN=on and an https address for the web app (for example over Tailscale).
BIND_HOST=
PUBLIC_WEB_ORIGIN=
PUBLIC_API_ORIGIN=
# Optional: a secret (32+ chars) that signs the login cookie. If empty, one is made in DATA_DIR/secrets.
AUTH_SECRET=

# The company time zone for scheduled runs (an IANA name such as Asia/Karachi). Empty: this machine's own.
COMPANY_TIMEZONE=

# When the morning brief is built each day (HH:MM in the company time zone). Empty: 06:30.
BRIEF_TIME=
