    "better-auth": "^1.7.20",
    "cron-parser": "^5.10.4",
    "drizzle-orm": "0.45.4",
    "embedded-postgres": "18.6.0-beta.19",
    "hono": "4.13.17",
    "inngest": "4.26.2",
    "pg": "8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
